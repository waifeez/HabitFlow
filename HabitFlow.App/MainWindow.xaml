<Window x:Class="HabitFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HabitFlow" Width="480" Height="780" MinWidth="440" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: дата, прогресс за день, уровень -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="Сегодня" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TodayText}" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Opacity="0.7" />
            </Grid>
            <TextBlock Text="{Binding Summary}" Margin="0,4,0,12" Opacity="0.7" />
            <Grid>
                <TextBlock Text="{Binding Level, StringFormat=Уровень {0}}" FontWeight="SemiBold" />
                <TextBlock HorizontalAlignment="Right" Opacity="0.7">
                    <Run Text="{Binding XpIntoLevel, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding XpPerLevel, Mode=OneWay}" /><Run Text=" XP" />
                </TextBlock>
            </Grid>
            <ProgressBar Margin="0,6,0,0" Height="8" Minimum="0"
                         Maximum="{Binding XpPerLevel}" Value="{Binding XpIntoLevel}" />
        </StackPanel>

        <!-- Плашка о новом достижении -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="#E8F5E9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Notice}" Foreground="#1B5E20" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2">
            <!-- Вкладка «Привычки» -->
            <TabItem Header="Привычки">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Добавление привычки -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Width="60" Margin="0,0,10,0" VerticalAlignment="Bottom"
                                      ItemsSource="{Binding Emojis}" SelectedItem="{Binding SelectedEmoji}" />

                            <TextBox Grid.Column="1" VerticalAlignment="Bottom"
                                     materialDesign:HintAssist.Hint="Новая привычка"
                                     Text="{Binding NewHabitName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="2" Content="Добавить" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding AddCommand}" />
                        </Grid>

                        <TextBlock Text="Дни недели" Margin="0,12,0,4" Opacity="0.7" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding DayOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,14,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AddError}" Foreground="Red" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Список привычек -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Habits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      IsEnabled="{Binding IsScheduledToday}"
                                                      IsChecked="{Binding IsDoneToday, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />

                                            <TextBlock Grid.Column="1" Text="{Binding Emoji}" FontSize="20"
                                                       Margin="10,0" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ScheduleText}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding StreakText}" Opacity="0.7"
                                                       Margin="10,0" VerticalAlignment="Center" />

                                            <Button Grid.Column="4" Content="✕" Padding="8,0"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsScheduledToday}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка «Статистика» -->
            <TabItem Header="Статистика">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Карточки с итогами -->
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <Border Background="#F3EFFA" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatTotalChecks}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Всего отметок" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F3EFFA" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatLongestStreak}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Лучшая серия, дн." FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F3EFFA" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatCompletion}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Выполнение за 30 дн." FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F3EFFA" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatHabitCount}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Привычек" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Диаграмма за 7 дней -->
                        <TextBlock Text="Отметки за последние 7 дней" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding WeekBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="100" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Count}" HorizontalAlignment="Center"
                                                   FontSize="11" Opacity="0.7" />
                                        <Border Grid.Row="1" Width="26" Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom" Background="#7E57C2"
                                                CornerRadius="3,3,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" HorizontalAlignment="Center"
                                                   FontSize="11" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Календарь активности -->
                        <TextBlock Text="Активность за 12 недель" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <UniformGrid Rows="7" Columns="1" Width="28" Height="168">
                                <TextBlock Text="Пн" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock />
                                <TextBlock Text="Ср" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock />
                                <TextBlock Text="Пт" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock />
                                <TextBlock Text="Вс" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding HeatCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="7" Columns="12" Width="288" Height="168" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" CornerRadius="3" Background="{Binding Fill}"
                                                ToolTip="{Binding Tip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Легенда -->
                        <StackPanel Orientation="Horizontal" Margin="28,8,0,0">
                            <TextBlock Text="Меньше" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                            <Border Width="14" Height="14" Margin="6,0,0,0" CornerRadius="3" Background="#EEEEEE" />
                            <Border Width="14" Height="14" Margin="3,0,0,0" CornerRadius="3" Background="#D1C4E9" />
                            <Border Width="14" Height="14" Margin="3,0,0,0" CornerRadius="3" Background="#B39DDB" />
                            <Border Width="14" Height="14" Margin="3,0,0,0" CornerRadius="3" Background="#7E57C2" />
                            <Border Width="14" Height="14" Margin="3,0,6,0" CornerRadius="3" Background="#512DA8" />
                            <TextBlock Text="Больше" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка «Достижения» -->
            <TabItem Header="Достижения">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding AchievementsSummary}" Margin="0,0,0,8" Opacity="0.7" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Achievements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DisplayEmoji}" FontSize="28"
                                                       Width="48" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                            <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>